# ─── finsmart-backend/.env.example ───────────────────────────────────────────
# Copy this file to ".env" and fill in your real values.
# NEVER put real keys in this file — it is committed to GitHub.

PORT=5000

GROQ_API_KEY=your_groq_api_key_here

MONGODB_URI=your_mongodb_connection_string_here

FRONTEND_URL=http://localhost:3000



# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your React frontend.
# In development this is always http://localhost:3000
# In production, change this to your deployed Vercel URL.
FRONTEND_URL=http://localhost:3000





# # ── WhatsApp Business Cloud API ───────────────────────────────────────────────
# # All three values come from Meta Developer Portal → WhatsApp product settings
# # WHATSAPP_TOKEN      : System User Access Token (long-lived)
# # WHATSAPP_PHONE_ID   : Phone Number ID of your registered WhatsApp number
# # WHATSAPP_VERIFY_TOKEN : Any secret string YOU choose during webhook setup
# # APP_SECRET          : App Secret from Meta App Settings (for HMAC verification)
# WHATSAPP_TOKEN=your_whatsapp_system_user_access_token
# WHATSAPP_PHONE_ID=your_phone_number_id
# WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
# APP_SECRET=your_meta_app_secret
