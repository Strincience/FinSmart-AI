PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/finsmart
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Auth (generate a long random secret in production)
JWT_SECRET=please_change_me_generate_a_secure_random_string
JWT_EXPIRES_IN=7d

# CORS origin for the SPA (comma-separated origins not supported — single origin)
FRONTEND_URL=http://localhost:3000
