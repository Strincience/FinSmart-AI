# ─── finsmart-backend/.env.example ──────────────────────────────────────────
#
# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual .env file to Git — it contains secrets.
#
# Step-by-step instructions for each variable are in the README.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# The port the Express server listens on.
# The React frontend's Vite proxy forwards to this port automatically.
PORT=5000

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Get this from: https://console.anthropic.com → API Keys → Create Key
# It looks like:  sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Your Cluster → Connect → Drivers
# It looks like:  mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/finsmart
MONGODB_URI=your_mongodb_connection_string_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your React frontend.
# In development this is always http://localhost:3000
# In production, change this to your deployed Vercel URL.
FRONTEND_URL=http://localhost:3000
